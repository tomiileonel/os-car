{
  "name": "os-car",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint src app tests middleware.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "auth:generate": "npx @better-auth/cli generate",
    "auth:migrate": "node ./scripts/run-migrations.mjs",
    "test": "vitest run",
    "test:g5-neon": "npx tsx scripts/run-g5-neon-benchmark.ts",
    "db:seed:g11": "tsx prisma/seed-g11.ts",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "worker:outbox": "tsx scripts/run-outbox-worker.ts"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true
  },
