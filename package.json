{
  "name": "os-car",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint src app tests middleware.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "auth:generate": "npx @better-auth/cli generate",
    "auth:migrate": "node ./scripts/run-migrations.mjs",
    "test": "vitest run",
    "test:g5-neon": "npx tsx scripts/run-g5-neon-benchmark.ts",
    "db:seed:g11": "tsx prisma/seed-g11.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/functions": "^3.9.5",
    "better-auth": "^1.1.21",
    "decimal.js": "^10.6.0",
    "ioredis": "^6.0.0",
    "next": "^15.1.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
